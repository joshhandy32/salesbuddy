// SalesBuddy database — local SQLite file, no external server.
// The structured brief JSON is stored as text columns (SQLite has no JSON type);
// we JSON.parse it back into BriefResult in the app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brief {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional rep this brief belongs to — used to scope per-rep memory.
  repName String?

  // Optional deal metadata — calibrates the brief to the deal.
  company   String?
  dealSize  String?
  industry  String?
  aeName    String?

  // Raw inputs the brief was generated from.
  email      String
  transcript String
  notes      String

  // The AI-generated brief, as JSON text (a BriefResult).
  result String

  // ── Feedback / memory signal ──────────────────────────────────────────
  // 1–5 star rating, null until rated.
  rating Int?
  // Freeform note from the rep on what to fix / what was good.
  feedbackNote String?
  // The rep's edited version of the brief, as JSON text (a BriefResult).
  // Null unless the rep corrected it. Future briefs prefer this version.
  corrected String?

  // True when extraction failed (AI error / empty deal summary) — UI shows
  // "Untitled brief" with a warning instead of the error text.
  flagged Boolean @default(false)

  @@index([repName, createdAt])
}

// Pacing & Commission tool — a single settings row so quota/commission config
// isn't re-entered each visit. id is fixed to "default".
model PacingSettings {
  id              String   @id @default("default")
  quota           Int      @default(8)
  commissionModel String   @default("percent") // "percent" | "flat"
  commissionRate  Float    @default(3) // percent value, e.g. 3 means 3%
  flatBonus       Float    @default(500) // $ per closed deal for the flat model
  updatedAt       DateTime @updatedAt
}

// A logged demo set — feeds the Pacing & Commission tool's "demos set this
// month" count and optionally posts a plain-text call-out to Slack.
model DemoSet {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  setType       String // CC | LinkedIn | Email | RSC | FL
  prospect      String // name and/or company
  need          String
  demoDate      DateTime
  aeName        String?
  notes         String? // internal only, never sent to Slack
  postedToSlack Boolean  @default(false)

  // Status tracking — feeds pacing + commission math.
  // SET|SHOWED|NO_SHOW|RESCHEDULED|COMPLETED|CLOSED_WON|CLOSED_LOST|RELIEF
  status        String    @default("SET")
  shownDate     DateTime?
  completedDate DateTime?
  closedDate    DateTime?
  dealRevenue   Float? // captured at CLOSED_WON
}

// A submitted monthly commission recap + its approval state.
model Recap {
  id             String   @id @default(cuid())
  month          String // YYYY-MM
  commissionOwed Float    @default(0)
  revenue        Float    @default(0)
  completes      Int      @default(0)
  closedDeals    Int      @default(0)
  reliefs        Int      @default(0)
  quota          Int      @default(0)
  attainment     Float    @default(0)
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED
  managerNotes   String   @default("")
  submittedAt    DateTime @default(now())
}

// A logged call-blitz (power hour) session. Counts are captured live in the
// Call Blitz tool; on save they also increment the current month's Historical
// dials / connects / conversations so pacing stays in sync.
model BlitzSession {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  durationSec   Int      @default(0)
  dials         Int      @default(0)
  connects      Int      @default(0)
  conversations Int      @default(0)
  demosSet      Int      @default(0)
  notes         String?

  @@index([createdAt])
}

// Monthly historicals for the Pacing Calculator. Month is "YYYY-MM". The current
// month's demo-derived fields are auto-synced from logged DemoSets.
model Historical {
  id            String   @id @default(cuid())
  month         String   @unique // "YYYY-MM"
  dials         Int      @default(0)
  connects      Int      @default(0)
  conversations Int      @default(0)
  orumDemoSets  Int      @default(0)
  otherDemoSets Int      @default(0)
  demoShows     Int      @default(0)
  demoCompletes Int      @default(0)
  closedDeals   Int      @default(0)
  revenue       Float    @default(0)
  reliefs       Int      @default(0)
  createdAt     DateTime @default(now())
}

// The rep's profile + targets. Single row for now (id "default"), shaped to
// support multiple users later.
model UserProfile {
  id              String   @id @default("default")
  name            String   @default("")
  role            String   @default("BDR") // BDR | AE | Manager
  quota           Int      @default(8) // monthly completes
  tier            String   @default("BDR1") // BDR1 | BDR2 | BDR3 | AE
  workingDays     Int? // null = auto-calc (weekdays this month)
  commissionModel String   @default("percent") // percent | flat
  commissionRate  Float    @default(3) // percent value
  flatBonus       Float    @default(500) // $ per deal
  updatedAt       DateTime @updatedAt
}

// Slack routing config — a single row so the channel can be changed later from a
// settings page without redeploying. Seeded from SLACK_CHANNEL_ID on first run.
model SlackSettings {
  id          String   @id @default("default")
  channelId   String
  // Human-readable channel name (e.g. "zeni-army"), resolved once from the
  // Slack API and cached so Settings doesn't re-fetch on every page load.
  channelName String?
  updatedAt   DateTime @updatedAt
}

// Week-over-week coaching: the last priority generated for each rep, so the
// next digest can report whether they improved on it.
model CoachingSnapshot {
  repName   String   @id
  priority  String
  updatedAt DateTime @updatedAt
}

// A past month in the pacing historicals table. Attainment is derived
// (completes / quota) at display time.
model PacingMonth {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  month     String // e.g. "May 2026"
  sets      Int
  shows     Int
  completes Int
  quota     Int
}
